@{
    ViewData["Title"] = "Điều chuyển nguyên liệu";
}
<section class="panel">
    <header class="panel-head"><div><h3>Phiếu điều chuyển</h3><small class="text-muted">Draft → InTransit → Received</small></div><div class="action-row"><button class="btn btn-outline-brand btn-sm" onclick="loadTransfers()">Làm mới</button><button class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#transferModal">Tạo phiếu</button></div></header>
    <div class="panel-body border-bottom"><div class="search-row"><input class="form-control" id="tfSearch" placeholder="Tìm mã phiếu hoặc Kitchen..." oninput="renderTransfers()" /><select class="form-select" id="tfStatus" onchange="renderTransfers()"><option value="">Tất cả trạng thái</option><option>Draft</option><option>InTransit</option><option>Received</option><option>Cancelled</option></select></div></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Mã phiếu</th><th>Từ</th><th>Đến</th><th>Trạng thái</th><th>Nguyên liệu</th><th>Thời gian</th><th>Thao tác</th></tr></thead><tbody id="tfBody"></tbody></table></div>
</section>
<div class="modal fade" id="transferModal" tabindex="-1"><div class="modal-dialog modal-lg"><form class="modal-content" id="transferForm"><div class="modal-header"><h5 class="modal-title">Tạo TransferRequest Draft</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="tfAlert"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Bếp tổng xuất</label><select class="form-select" id="fromKitchen" required></select></div><div class="col-md-6"><label class="form-label">Chi nhánh nhận</label><select class="form-select" id="toKitchen" required></select></div></div><label class="form-label mt-3">Ghi chú</label><textarea id="tfNote" class="form-control" rows="2"></textarea><div class="d-flex justify-content-between align-items-center mt-4 mb-2"><b>Nguyên liệu điều chuyển</b><button type="button" class="btn btn-sm btn-outline-brand" onclick="addTfRow()">+ Thêm nguyên liệu</button></div><div id="tfItems"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button><button class="btn btn-brand" type="submit">Tạo phiếu Draft</button></div></form></div></div>
@section Scripts {
<script>
let transfers=[],kitchens=[],ingredients=[];
async function loadTransfers(){try{[transfers,kitchens,ingredients]=await Promise.all([OsyApi.request('/api/transfers'),OsyApi.request('/api/kitchens'),OsyApi.request('/api/ingredients')]);document.getElementById('fromKitchen').innerHTML=kitchens.filter(x=>x.isActive&&x.isCentralKitchen).map(x=>'<option value="'+x.kitchenId+'">'+OsyUi.escape(x.kitchenName)+'</option>').join('');document.getElementById('toKitchen').innerHTML=kitchens.filter(x=>x.isActive&&!x.isCentralKitchen).map(x=>'<option value="'+x.kitchenId+'">'+OsyUi.escape(x.kitchenName)+'</option>').join('');if(!document.querySelector('#tfItems .tf-item-row'))addTfRow();renderTransfers();}catch(e){OsyUi.toast(e.message,'danger');}}
function renderTransfers(){const q=document.getElementById('tfSearch').value.toLowerCase(),s=document.getElementById('tfStatus').value;const rows=transfers.filter(x=>(!q||'#'+x.transferRequestId+' '+x.fromKitchenName+' '+x.toKitchenName.toLowerCase().includes(q))&&(!s||x.status===s));document.getElementById('tfBody').innerHTML=rows.length?rows.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).map(x=>'<tr><td><b>#'+x.transferRequestId+'</b></td><td>'+OsyUi.escape(x.fromKitchenName)+'</td><td>'+OsyUi.escape(x.toKitchenName)+'</td><td>'+OsyUi.badge(x.status)+'</td><td>'+(x.items?.length||0)+' loại</td><td>'+OsyUi.date(x.createdAt)+'</td><td><div class="action-row">'+(x.status==='Draft'?'<button class="btn btn-sm btn-warm" onclick="tfAction('+x.transferRequestId+',\'send\')">Send</button><button class="btn btn-sm btn-outline-danger" onclick="tfAction('+x.transferRequestId+',\'cancel\')">Cancel</button>':'')+(x.status==='InTransit'?'<button class="btn btn-sm btn-success" onclick="tfAction('+x.transferRequestId+',\'receive\')">Receive</button>':'')+'<button class="btn btn-sm btn-light" onclick="showTf('+x.transferRequestId+')">Chi tiết</button></div></td></tr>').join(''):'<tr><td colspan="7" class="empty-state">Chưa có phiếu điều chuyển.</td></tr>';}
function addTfRow(){const row=document.createElement('div');row.className='tf-item-row row g-2 mb-2';row.innerHTML='<div class="col-8"><select class="form-select item-ingredient">'+ingredients.filter(x=>x.isActive).map(x=>'<option value="'+x.ingredientId+'">'+OsyUi.escape(x.ingredientName)+' ('+OsyUi.escape(x.unit)+')</option>').join('')+'</select></div><div class="col-3"><input class="form-control item-qty" type="number" min="0.001" step="0.001" value="1" /></div><div class="col-1"><button type="button" class="btn btn-light" onclick="this.closest(\'.tf-item-row\').remove()">×</button></div>';document.getElementById('tfItems').appendChild(row);}
async function tfAction(id,action){if(!await OsyUi.confirm('Thực hiện '+action+' cho Transfer #'+id+'?'))return;try{const r=await OsyApi.request('/api/transfers/'+id+'/'+action,{method:'PATCH'});OsyUi.toast('Transfer #'+id+': '+action+' thành công.'+(r?.warnings?.length?' Có '+r.warnings.length+' cảnh báo kho.':''));await loadTransfers();}catch(e){OsyUi.toast(e.message,'danger');}}
function showTf(id){const x=transfers.find(t=>t.transferRequestId===id);if(!x)return;OsyUi.showDetail('Transfer #'+x.transferRequestId,'<div class="detail-grid"><div><small>Từ</small><b>'+OsyUi.escape(x.fromKitchenName)+'</b></div><div><small>Đến</small><b>'+OsyUi.escape(x.toKitchenName)+'</b></div><div><small>Trạng thái</small>'+OsyUi.badge(x.status)+'</div><div><small>Thời gian</small><b>'+OsyUi.date(x.createdAt)+'</b></div>'+(x.note?'<div class="col-span-2"><small>Ghi chú</small><p class="mb-0">'+OsyUi.escape(x.note)+'</p></div>':'')+'</div><h6 class="mt-4 mb-2">Nguyên liệu điều chuyển</h6><div class="table-responsive"><table class="table"><thead><tr><th>Nguyên liệu</th><th>Số lượng</th></tr></thead><tbody>'+(x.items||[]).map(i=>'<tr><td>'+OsyUi.escape(i.ingredientName)+'</td><td>'+OsyUi.number(i.quantity)+' '+OsyUi.escape(i.unit)+'</td></tr>').join('')+'</tbody></table></div>');}
document.getElementById('transferForm').addEventListener('submit',async function(e){e.preventDefault();const items=[...document.querySelectorAll('.tf-item-row')].map(r=>({ingredientId:Number(r.querySelector('.item-ingredient').value),quantity:Number(r.querySelector('.item-qty').value)}));if(!items.length){OsyUi.alert('tfAlert','Phiếu phải có ít nhất một nguyên liệu.','danger');return;}try{await OsyApi.request('/api/transfers',{method:'POST',body:{fromKitchenId:Number(document.getElementById('fromKitchen').value),toKitchenId:Number(document.getElementById('toKitchen').value),note:document.getElementById('tfNote').value.trim()||null,items}});OsyUi.modal('transferModal').hide();OsyUi.toast('Tạo phiếu Draft thành công.');document.getElementById('tfItems').innerHTML='';addTfRow();await loadTransfers();}catch(e){OsyUi.alert('tfAlert',e.message,'danger');}});
loadTransfers();
</script>
}