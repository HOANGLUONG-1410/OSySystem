@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="api-base-url" content="@(Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7055")" />
    <title>Đăng nhập - Bún Bò Huế OSỹ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-visual">
        <div class="login-copy">
            <span class="heritage-label">HỆ THỐNG QUẢN LÝ CHUỖI</span>
            <h1>Chuẩn hóa vận hành.<br /><em>Giữ trọn vị Huế.</em></h1>
            <p>Quản lý bếp trung tâm, chi nhánh, tồn kho, đơn hàng và điều chuyển trên một giao diện trực quan.</p>
            <div class="core-values"><span>NGON</span><span>SẠCH</span><span>NHANH</span></div>
        </div>
    </div>
    <section class="login-panel">
        <form class="login-card" id="loginForm">
            <img src="~/images/osy-logo.png" alt="Bún Bò Huế OSỹ" class="login-logo" />
            <p class="eyebrow">OSỸ OPERATIONS</p>
            <h2>Chào mừng trở lại</h2>
            <p class="text-muted">Đăng nhập để bắt đầu kiểm thử hệ thống.</p>
            <div id="loginAlert"></div>
            <label class="form-label">Tên đăng nhập</label>
            <input class="form-control form-control-lg" id="username" value="admin" autocomplete="username" required />
            <label class="form-label mt-3">Mật khẩu</label>
            <div class="input-group">
                <input type="password" class="form-control form-control-lg" id="password" value="Admin@123" autocomplete="current-password" required />
                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password', this)" tabindex="-1">
                    <span class="eye-icon">&#128065;</span>
                </button>
            </div>
            <button class="btn btn-brand btn-lg w-100 mt-4" type="submit">Đăng nhập</button>
            <small class="login-note">API: <span id="apiUrlText"></span></small>
        </form>
    </section>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <script>
        function togglePassword(id, btn) {
            var input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                btn.querySelector('.eye-icon').innerHTML = '&#128064;';
            } else {
                input.type = 'password';
                btn.querySelector('.eye-icon').innerHTML = '&#128065;';
            }
        }
        document.getElementById('apiUrlText').textContent = OsyApi.baseUrl;
        document.getElementById('loginForm').addEventListener('submit', async function (event) {
            event.preventDefault();
            const button = this.querySelector('button');
            button.disabled = true;
            try {
                const result = await OsyApi.request('/api/auth/login', {
                    method: 'POST',
                    anonymous: true,
                    body: {
                        username: document.getElementById('username').value.trim(),
                        password: document.getElementById('password').value
                    }
                });
                OsyAuth.saveSession(result);
                window.location.href = OsyAuth.getRoleRedirect();
            } catch (error) {
                OsyUi.alert('loginAlert', error.message, 'danger');
            } finally {
                button.disabled = false;
            }
        });
    </script>
</body>
</html>
