@{
    ViewData["Title"] = "Đơn hàng";
}
<section class="panel">
    <header class="panel-head"><div><h3>Đơn hàng</h3><small class="text-muted">Pending → Confirmed → Completed</small></div><div class="action-row"><button class="btn btn-outline-brand btn-sm" onclick="loadOrders()">Làm mới</button><button class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#orderModal">Tạo đơn</button></div></header>
    <div class="panel-body border-bottom"><div class="search-row"><input class="form-control" id="orderSearch" placeholder="Tìm mã đơn..." oninput="renderOrders()" /><select class="form-select" id="orderStatus" onchange="renderOrders()"><option value="">Tất cả trạng thái</option><option>Pending</option><option>Confirmed</option><option>Completed</option><option>Cancelled</option></select></div></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Trạng thái</th><th>Tổng tiền</th><th>Thời gian</th><th>Thao tác</th></tr></thead><tbody id="orderBody"></tbody></table></div>
</section>
<div class="modal fade" id="orderModal" tabindex="-1"><div class="modal-dialog modal-lg"><form class="modal-content" id="orderForm"><div class="modal-header"><h5 class="modal-title">Tạo Order Pending</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="orderAlert"></div><div class="d-flex justify-content-between align-items-center mb-2"><b>Danh sách món</b><button type="button" class="btn btn-sm btn-outline-brand" onclick="addOrderRow()">+ Thêm món</button></div><div id="orderItems"></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button><button class="btn btn-brand" type="submit">Tạo đơn</button></div></form></div></div>
@section Scripts {
<script>
let orders=[],menuItems=[],kitchens=[];
async function loadOrders(){try{[orders,kitchens,menuItems]=await Promise.all([OsyApi.request('/api/orders'),OsyApi.request('/api/kitchens'),OsyApi.request('/api/menu-items')]);if(!document.querySelector('#orderItems .order-item-row'))addOrderRow();renderOrders();}catch(e){OsyUi.toast(e.message,'danger');}}
function renderOrders(){const q=document.getElementById('orderSearch').value.toLowerCase(),s=document.getElementById('orderStatus').value;const rows=orders.filter(x=>(!q||'#'+x.orderId.toLowerCase().includes(q))&&(!s||x.status===s));document.getElementById('orderBody').innerHTML=rows.length?rows.sort((a,b)=>new Date(b.orderDate)-new Date(a.orderDate)).map(x=>'<tr><td><b>#'+x.orderId+'</b></td><td>'+OsyUi.badge(x.status)+'</td><td><b>'+OsyUi.money(x.totalAmount)+'</b></td><td>'+OsyUi.date(x.orderDate)+'</td><td><div class="action-row">'+(x.status==='Pending'?'<button class="btn btn-sm btn-warm" onclick="orderAction('+x.orderId+',\'confirm\')">Confirm</button><button class="btn btn-sm btn-outline-danger" onclick="orderAction('+x.orderId+',\'cancel\')">Cancel</button>':'')+(x.status==='Confirmed'?'<button class="btn btn-sm btn-success" onclick="orderAction('+x.orderId+',\'complete\')">Complete</button>':'')+'<button class="btn btn-sm btn-light" onclick="showOrder('+x.orderId+')">Chi tiết</button></div></td></tr>').join(''):'<tr><td colspan="5" class="empty-state">Chưa có đơn hàng</td></tr>';}
function addOrderRow(){const row=document.createElement('div');row.className='order-item-row row g-2 mb-2';row.innerHTML='<div class="col-8"><select class="form-select item-menu">'+menuItems.filter(x=>x.isActive).map(x=>'<option value="'+x.menuItemId+'">'+OsyUi.escape(x.menuItemName)+' - '+OsyUi.money(x.sellingPrice)+'</option>').join('')+'</select></div><div class="col-3"><input type="number" min="1" value="1" class="form-control item-qty" /></div><div class="col-1"><button type="button" class="btn btn-light" onclick="this.closest(\'.order-item-row\').remove()">×</button></div>';document.getElementById('orderItems').appendChild(row);}
async function orderAction(id,action){if(!await OsyUi.confirm('Thực hiện '+action+' cho Order #'+id+'?'))return;try{const r=await OsyApi.request('/api/orders/'+id+'/'+action,{method:'PATCH'});OsyUi.toast('Order #'+id+': '+action+' thành công.'+(r?.warnings?.length?' Có '+r.warnings.length+' cảnh báo kho.':''));await loadOrders();}catch(e){OsyUi.toast(e.message,'danger');}}
function showOrder(id){const x=orders.find(o=>o.orderId===id);if(!x)return;OsyUi.showDetail('Order #'+x.orderId,'<div class="detail-grid"><div><small>Kitchen</small><b>'+OsyUi.escape(x.kitchenName)+'</b></div><div><small>Trạng thái</small>'+OsyUi.badge(x.status)+'</div><div><small>Tổng tiền</small><b>'+OsyUi.money(x.totalAmount)+'</b></div><div><small>Thời gian</small><b>'+OsyUi.date(x.orderDate)+'</b></div></div><h6 class="mt-4 mb-2">Chi tiết món</h6><div class="table-responsive"><table class="table"><thead><tr><th>Món</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>'+(x.orderDetails||[]).map(d=>'<tr><td>'+OsyUi.escape(d.menuItemName)+'</td><td>x'+d.quantity+'</td><td>'+OsyUi.money(d.subTotal)+'</td></tr>').join('')+'</tbody></table></div>');}
document.getElementById('orderForm').addEventListener('submit',async function(e){e.preventDefault();const items=[...document.querySelectorAll('.order-item-row')].map(r=>({menuItemId:Number(r.querySelector('.item-menu').value),quantity:Number(r.querySelector('.item-qty').value)}));if(!items.length){OsyUi.alert('orderAlert','Đơn hàng phải có ít nhất một món.','danger');return;}const branchKitchen=kitchens.find(k=>k.isActive&&!k.isCentralKitchen);try{await OsyApi.request('/api/orders',{method:'POST',body:{kitchenId:branchKitchen?.kitchenId,items}});OsyUi.modal('orderModal').hide();OsyUi.toast('Tạo Order Pending thành công.');document.getElementById('orderItems').innerHTML='';addOrderRow();await loadOrders();}catch(e){OsyUi.alert('orderAlert',e.message,'danger');}});
loadOrders();
</script>
}