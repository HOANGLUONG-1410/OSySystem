@{
    ViewData["Title"] = "Kho nguyên liệu - Bếp trung tâm";
}
<section class="panel">
    <header class="panel-head"><div><h3>Tồn kho hiện tại</h3></div><div class="action-row"><button class="btn btn-outline-brand btn-sm" onclick="loadInventory()">Làm mới</button><button class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">Nhập kho</button></div></header>
    <div class="panel-body border-bottom"><div class="search-row"><input class="form-control" id="invSearch" placeholder="Tìm nguyên liệu..." oninput="renderInventory()" /><label class="form-check"><input class="form-check-input" type="checkbox" id="negativeOnly" onchange="renderInventory()" /> <span class="form-check-label">Chỉ tồn âm</span></label></div></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Nguyên liệu</th><th>Đơn vị</th><th>Số lượng</th><th>Giá vốn</th><th>Giá trị tồn</th><th>Cập nhật</th></tr></thead><tbody id="invBody"></tbody></table></div>
</section>
<section class="panel">
    <header class="panel-head"><h3>Lịch sử biến động</h3><button class="btn btn-sm btn-outline-brand" onclick="loadLogs()">Tải log</button></header>
    <div class="table-responsive"><table class="table"><thead><tr><th>Thời gian</th><th>Nguyên liệu</th><th>Loại</th><th>Thay đổi</th><th>Trước → Sau</th><th>Người thực hiện</th></tr></thead><tbody id="logBody"><tr><td colspan="6" class="empty-state">Nhấn "Tải log" để xem.</td></tr></tbody></table></div>
</section>
<div class="modal fade" id="importModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" id="importForm"><div class="modal-header"><h5 class="modal-title">Nhập kho</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="importAlert"></div><label class="form-label">Nguyên liệu</label><select class="form-select" id="importIngredient" required></select><div class="row g-3 mt-0"><div class="col-6"><label class="form-label">Số lượng</label><input class="form-control" id="importQty" type="number" step="0.001" min="0.001" required /></div><div class="col-6"><label class="form-label">Đơn giá</label><input class="form-control" id="importCost" type="number" step="100" min="0" required /></div></div><label class="form-label mt-3">Ghi chú</label><textarea class="form-control" id="importNote" rows="2" placeholder="Ví dụ: Nhập hàng đầu tuần"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button><button class="btn btn-brand" type="submit">Nhập kho</button></div></form></div></div>
@section Scripts {
<script>
let inventories=[],ingredients=[],kitchens=[];
async function loadInventory(){try{[inventories,kitchens,ingredients]=await Promise.all([OsyApi.request('/api/inventories'),OsyApi.request('/api/kitchens'),OsyApi.request('/api/ingredients')]);document.getElementById('importIngredient').innerHTML=ingredients.filter(x=>x.isActive).map(x=>'<option value="'+x.ingredientId+'">'+OsyUi.escape(x.ingredientName)+' ('+OsyUi.escape(x.unit)+')</option>').join('');renderInventory();}catch(e){OsyUi.toast(e.message,'danger');}}
function renderInventory(){const q=document.getElementById('invSearch').value.toLowerCase(),neg=document.getElementById('negativeOnly').checked;const rows=inventories.filter(x=>(!q||x.ingredientName.toLowerCase().includes(q))&&(!neg||x.isNegative));document.getElementById('invBody').innerHTML=rows.length?rows.map(x=>'<tr><td><b>'+OsyUi.escape(x.ingredientName)+'</b></td><td>'+OsyUi.escape(x.unit)+'</td><td>'+(x.isNegative?OsyUi.badge(OsyUi.number(x.quantity)):'<b>'+OsyUi.number(x.quantity)+'</b>')+'</td><td>'+OsyUi.money(x.averageCost)+'</td><td>'+OsyUi.money(x.inventoryValue)+'</td><td>'+OsyUi.date(x.lastUpdated)+'</td></tr>').join(''):'<tr><td colspan="6" class="empty-state">Không có dữ liệu</td></tr>';}
async function loadLogs(){try{const logs=await OsyApi.request('/api/inventories/logs');document.getElementById('logBody').innerHTML=logs.length?logs.slice(0,100).map(x=>'<tr><td>'+OsyUi.date(x.createdAt)+'</td><td>'+OsyUi.escape(x.ingredientName)+'</td><td>'+OsyUi.badge(x.logType)+'</td><td><b>'+(Number(x.quantityChange)>0?'+':'')+OsyUi.number(x.quantityChange)+'</b></td><td>'+OsyUi.number(x.quantityBefore)+' → '+OsyUi.number(x.quantityAfter)+'</td><td>'+OsyUi.escape(x.performedByName||'System')+'</td></tr>').join(''):'<tr><td colspan="6" class="empty-state">Chưa có log.</td></tr>';}catch(e){OsyUi.toast(e.message,'danger');}}
document.getElementById('importForm').addEventListener('submit',async function(e){e.preventDefault();try{await OsyApi.request('/api/inventories/import',{method:'POST',body:{kitchenId:kitchens.find(k=>k.isCentralKitchen)?.kitchenId,ingredientId:Number(document.getElementById('importIngredient').value),quantity:Number(document.getElementById('importQty').value),unitCost:Number(document.getElementById('importCost').value),note:document.getElementById('importNote').value.trim()||null}});OsyUi.modal('importModal').hide();OsyUi.toast('Nhập kho thành công.');this.reset();await loadInventory();}catch(e){OsyUi.alert('importAlert',e.message,'danger');}});
loadInventory();
</script>
}